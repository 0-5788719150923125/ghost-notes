; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ghost"
config/description="A spectral music visualizer - scene definitions modulated by audio features."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
config/icon="res://icon.svg"
run/flush_stdout_on_print=true

[audio]

driver/output_latency=40
driver/enable_input=true

[autoload]

Settings="*res://src/settings.gd"
Boot="*res://src/boot.gd"
Spectrum="*res://src/spectrum.gd"
Director="*res://src/director.gd"
Provisioner="*res://src/provisioner.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/handheld/orientation=1

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/viewport_width.mobile=1080
window/size/viewport_height.mobile=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
