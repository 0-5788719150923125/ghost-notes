; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ghost Notes"
config/description="A spectral experience"
config/use_custom_user_dir=true
config/custom_user_dir_name="godot/app_userdata/ghost"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
run/flush_stdout_on_print=true

[audio]

driver/output_latency=40
driver/enable_input=true

[autoload]

Settings="*res://src/platform/settings.gd"
Boot="*res://src/platform/boot.gd"
Spectrum="*res://src/audio/spectrum.gd"
Director="*res://src/show/director.gd"
Provisioner="*res://src/platform/provisioner.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/handheld/orientation=1

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/viewport_width.mobile=1080
window/size/viewport_height.mobile=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_overrides]

text_editor/behavior/files/drop_preload_resources_as_uid=false

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
